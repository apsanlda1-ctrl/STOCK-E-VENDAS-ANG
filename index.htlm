<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Gestão de Stock e Faturação</title>
    <!-- Tailwind CSS para um design limpo e moderno -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="style.css">
</head>
<body class="bg-gray-50 text-gray-800 flex h-screen overflow-hidden">

    <!-- MENU LATERAL -->
    <aside class="w-64 bg-slate-900 text-white flex flex-col justify-between">
        <div class="p-5">
            <h1 class="text-xl font-bold tracking-wider text-emerald-400">GESTÃO AO</h1>
            <p class="text-xs text-slate-400 mt-1">Stock & Faturação</p>
            
            <nav class="mt-8 space-y-2">
                <button onclick="app.mudarSecao('dashboard')" class="w-full text-left px-4 py-2.5 rounded-lg hover:bg-slate-800 transition text-sm font-medium flex items-center gap-3">
                    📊 Dashboard
                </button>
                <button onclick="app.mudarSecao('stock')" class="w-full text-left px-4 py-2.5 rounded-lg hover:bg-slate-800 transition text-sm font-medium flex items-center gap-3">
                    📦 Stock / Produtos
                </button>
                <button onclick="app.mudarSecao('faturacao')" class="w-full text-left px-4 py-2.5 rounded-lg hover:bg-slate-800 transition text-sm font-medium flex items-center gap-3">
                    🧾 Nova Fatura
                </button>
                <button onclick="app.mudarSecao('clientes')" class="w-full text-left px-4 py-2.5 rounded-lg hover:bg-slate-800 transition text-sm font-medium flex items-center gap-3">
                    👥 Clientes
                </button>
            </nav>
        </div>
        <div class="p-4 bg-slate-950 text-xs text-slate-400 text-center">
            Moeda: <span class="text-emerald-400 font-bold">Kwanza (AOA)</span>
        </div>
    </aside>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="flex-1 flex flex-col overflow-y-auto">
        <!-- Barra Superior -->
        <header class="bg-white border-b border-gray-200 px-8 py-4 flex justify-between items-center shadow-sm">
            <h2 id="titulo-secao" class="text-xl font-semibold text-gray-800">Dashboard</h2>
            <div class="text-sm text-gray-500" id="data-atual"></div>
        </header>

        <!-- Área Dinâmica -->
        <div id="conteudo-principal" class="p-8">
            <!-- Os módulos serão injetados dinamicamente aqui via app.js -->
        </div>
    </main>

    <!-- Scripts da Aplicação -->
    <script src="db.js"></script>
    <script src="app.js"></script>
</body>
</html>
